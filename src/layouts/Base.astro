---
import site from '../../site.config.json';
import SeoHead from '../components/SeoHead.astro';
interface Props {
  title: string;
  description?: string;
  /** force noindex even post-stealth (e.g. 404, guides while thin) */
  noindex?: boolean;
  ogType?: string;
  /** per-page social card, e.g. an article hero image */
  ogImage?: string;
}
const { title, description = '', noindex = false, ogType = 'website', ogImage } = Astro.props;
const robots = site.stealth || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const canonical = new URL(Astro.url.pathname, site.SITE).href;
const ga4 = (site.ga4 && site.ga4.measurementId) || '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <SeoHead title={title} description={description} ogImage={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <slot name="head" />
  {ga4 && (
    <Fragment>
      {/* Google Consent Mode v2 — analytics_storage denied until the visitor accepts.
          GA4 still receives cookieless pings while denied, so traffic is measured
          from day one (Raptive requires GA history and it cannot be backfilled). */}
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        var __c = null;
        try { __c = localStorage.getItem('consent-analytics'); } catch (e) {}
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: __c === 'granted' ? 'granted' : 'denied'
        });
      </script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
      <script is:inline define:vars={{ ga4 }}>
        gtag('js', new Date());
        gtag('config', ga4);
      </script>
    </Fragment>
  )}
</head>
<body>
  <slot />

  {ga4 && (
    <div id="cookie-banner" class="cookie-banner" hidden>
      <p>
        We use cookies for analytics to understand what's useful here. Ads and
        affiliate links, where present, are always disclosed. See our
        <a href="/privacy/">privacy policy</a>.
      </p>
      <div class="cookie-actions">
        <button type="button" data-consent="denied" class="cookie-btn ghost">Decline</button>
        <button type="button" data-consent="granted" class="cookie-btn">Accept</button>
      </div>
    </div>
  )}

  <script is:inline>
    // ---- Cookie consent (interim). Mediavine's CMP replaces this at Journey approval. ----
    const banner = document.getElementById('cookie-banner');
    if (banner) {
      let stored = null;
      try { stored = localStorage.getItem('consent-analytics'); } catch (e) {}
      if (!stored) banner.hidden = false;
      banner.querySelectorAll('[data-consent]').forEach((b) => {
        b.addEventListener('click', () => {
          const v = b.getAttribute('data-consent');
          try { localStorage.setItem('consent-analytics', v); } catch (e) {}
          if (window.gtag) window.gtag('consent', 'update', { analytics_storage: v });
          banner.hidden = true;
        });
      });
    }
  </script>

  <script>
    // Global subscribe handler: any <form data-subscribe> posts the email to
    // /api/subscribe, which stores it in D1 AND subscribes it to this site's
    // MailerLite group (which triggers magnet delivery + the nurture sequence).
    // The file is also handed over instantly so the visitor never waits on email.
    import site from '../../site.config.json';
    const magnet = site.magnet || {};
    document.querySelectorAll('form[data-subscribe]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = form.querySelector('input[type="email"]');
        const btn = form.querySelector('button');
        const email = input && input.value ? input.value.trim() : '';
        if (!email) return;
        if (btn) { btn.disabled = true; btn.dataset.orig = btn.textContent; btn.textContent = '...'; }
        let ok = false;
        try {
          const r = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email })
          });
          ok = r.ok;
        } catch (err) {}
        const msg = document.createElement('p');
        msg.className = 'subscribe-done';
        if (ok && magnet.file) {
          const a = document.createElement('a');
          a.href = magnet.file; a.download = ''; document.body.appendChild(a); a.click(); a.remove();
          msg.innerHTML = (magnet.doneMessage || 'You are in - your download is starting now.') +
            ' <a href="' + magnet.file + '" download>Download did not start?</a>';
        } else if (ok) {
          msg.textContent = 'You are in - check your inbox.';
        } else {
          msg.textContent = 'Something went wrong - please try again.';
          if (btn) { btn.disabled = false; btn.textContent = btn.dataset.orig; }
        }
        form.insertAdjacentElement('afterend', msg);
        if (ok) form.hidden = true;
      });
    });
  </script>


  <script is:inline>
    (function () {
      document.addEventListener('click', function (e) {
        var el = e.target.closest('a.ad-filled, aside.offer-box a');
        if (!el) return;
        if (typeof gtag !== 'function') return;
        var slot = el.closest('aside.offer-box') ? 'offer_box' : 'banner';
        gtag('event', 'offer_click', {
          site: window.location.hostname,
          slot: slot,
          target_url: el.href,
          page: window.location.pathname
        });
      }, true);
    })();
  </script>
  <style is:global>
    .cookie-banner[hidden] { display: none; }
    .cookie-banner {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999;
      display: flex; flex-wrap: wrap; gap: 12px 24px;
      align-items: center; justify-content: center;
      padding: 14px 20px; background: #16181B; color: #F4F2ED;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; font-size: 14px;
      box-shadow: 0 -2px 18px rgba(0,0,0,.22);
    }
    .cookie-banner p { margin: 0; max-width: 70ch; }
    .cookie-banner a { color: inherit; text-decoration: underline; }
    .cookie-actions { display: flex; gap: 10px; }
    .cookie-btn {
      border: 0; border-radius: 6px; padding: 9px 18px; cursor: pointer;
      font: inherit; font-weight: 700; background: #F4F2ED; color: #16181B;
    }
    .cookie-btn.ghost { background: transparent; color: #F4F2ED; border: 1px solid rgba(244,242,237,.45); }
    .cookie-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  </style>

  <style is:global>
:root{--teal:#0E6E74;--teal-dark:#0A565B;--ink:#0B2F33;--sub:#3E6165;--muted:#5B7B7E;--bg:#F7FAFB;--amber:#EE9D3D;--glass:rgba(255,255,255,.78);--line:#E2EEEF}
  *{box-sizing:border-box}html{scroll-behavior:smooth}
  body{margin:0;color:var(--ink);background:var(--bg);font:16.5px/1.65 'IBM Plex Sans',system-ui,sans-serif}
  a{color:var(--teal-dark);text-decoration:none}button,input,select{font:inherit}
  h1,h2,h3{font-family:'Space Grotesk',sans-serif;letter-spacing:-0.02em}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .nav{position:sticky;z-index:20;top:0;background:rgba(255,255,255,.85);backdrop-filter:blur(14px);border-bottom:1px solid rgba(14,110,116,.12);display:flex;align-items:center;gap:18px;padding:12px max(24px,calc((100% - 1160px)/2))}
  .brand{display:flex;align-items:center;gap:9px;font:700 19px 'Space Grotesk',sans-serif;color:var(--ink);margin-right:auto;white-space:nowrap}.brand b{color:var(--teal)}
  footer .brand{color:#E7F4F5}
  .drop{width:20px;height:20px;border-radius:40% 40% 50% 50%;background:linear-gradient(160deg,var(--teal),var(--teal-dark));display:inline-block}.drop.small{width:16px;height:16px}
  .nav nav{display:flex;gap:4px;font-size:14.5px;font-weight:500}
  .nav nav a{padding:8px 12px;border-radius:9px;color:#33555A}.nav nav a:hover{background:#EDF5F6;color:var(--teal-dark)}
  .btn,form.email button{display:inline-flex;justify-content:center;align-items:center;gap:8px;border:0;border-radius:12px;padding:13px 22px;background:var(--amber);color:var(--ink);font:600 15px 'Space Grotesk',sans-serif;cursor:pointer;box-shadow:0 12px 26px -12px rgba(206,124,24,.7);transition:.18s}
  .btn:hover,form.email button:hover{transform:translateY(-2px)}.btn.sm{padding:9px 16px;font-size:13.5px;box-shadow:none;background:var(--teal);color:#fff}
  .ad{min-height:90px;width:min(970px,calc(100% - 32px));margin:22px auto;display:grid;place-items:center;border:1.5px dashed #C4DBDC;border-radius:10px;background:#FAFDFD;color:#8FA9AB;font:11px 'IBM Plex Mono',monospace;letter-spacing:1.8px;text-transform:uppercase}
  .hero{max-width:1140px;margin:0 auto;padding:clamp(48px,8vw,90px) 24px;display:flex;flex-wrap:wrap;gap:50px 60px;align-items:center;background:radial-gradient(1100px 520px at 78% -12%,#CFE9EA 0,transparent 62%)}
  .hero-copy{flex:1 1 500px;min-width:0}
  .eyebrow{margin:0 0 12px;font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:var(--teal-dark)}.eyebrow.light{color:#9FD4D7}
  .pill{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.7);border:1px solid #CFE4E5;border-radius:999px;padding:8px 14px}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--teal)}
  .hero h1{margin:0 0 20px;font-size:clamp(34px,5.4vw,58px);line-height:1.06;color:var(--ink)}.hero h1 span{color:var(--teal)}
  .lede{margin:0 0 28px;max-width:580px;font-size:clamp(16px,1.6vw,19px);color:var(--sub)}
  form.email{display:flex;gap:10px;max-width:520px}form.email input{flex:1;min-width:0;padding:14px 16px;border:1.5px solid #C6DDDE;border-radius:12px;background:#fff}
  form.email input:focus,input:focus,select:focus{outline:3px solid #BFE3E5}
  .micro{font-size:12.5px;color:var(--muted);margin-top:12px}.micro.on-dark{color:rgba(235,247,248,.65)}
  .hero-card{flex:0 1 320px;min-width:270px;padding:26px 28px;border-radius:20px}
  .glass{background:var(--glass);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.85);box-shadow:0 30px 70px -32px rgba(11,47,51,.4)}
  .rhythm{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:13px}
  .rhythm li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;color:var(--ink)}
  .rhythm .check{color:var(--teal);font-weight:700}.rhythm .warn{color:#B9770E;font-weight:700}
  .tag{margin:18px 0 0;display:inline-block;font:500 11px 'IBM Plex Mono',monospace;color:var(--teal-dark);background:#EAF4F5;border:1px solid #CFE4E5;border-radius:999px;padding:6px 12px}
  .trust{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:26px max(24px,calc((100% - 1140px)/2));display:flex;flex-wrap:wrap;gap:14px 26px;align-items:center;max-width:1140px;margin:0 auto}
  .trust-lede{margin:0;font:600 14px 'Space Grotesk',sans-serif}
  .trust-badges{display:flex;flex-wrap:wrap;gap:9px;margin-left:auto}
  .trust-badges span{padding:7px 13px;border:1px solid #D4E6E7;border-radius:999px;font:500 12px 'IBM Plex Mono',monospace;color:#33555A;background:#FBFDFD}
  .trust-note{margin:0;flex:1 1 100%;font-size:12.5px;color:var(--muted)}
  .section{max-width:1140px;margin:0 auto;padding:clamp(56px,8vw,100px) 24px}
  .head{max-width:700px;margin-bottom:36px}
  .head h2,.schedule h2,.offer h2,.final h2{margin:0 0 15px;font-size:clamp(30px,4vw,44px);line-height:1.1;color:var(--ink)}
  .head p{font-size:17px;color:var(--sub)}
  .problem .head p{margin:0 0 14px}.src{font:400 12.5px 'IBM Plex Mono',monospace;color:var(--muted)}
  .panel{border-radius:20px;padding:clamp(22px,3.5vw,32px);margin:32px 0}
  .panel h3{margin:0 0 6px;font-size:20px}.panel-sub{margin:0 0 8px;font-size:14px;color:#4A6B6E}
  .row{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;padding:15px 0;border-top:1px solid #D9EAEB}
  .row div{flex:1 1 220px}.row strong{display:block;font:600 15.5px 'Space Grotesk',sans-serif}.row small{color:#5B7B7E;font-size:12.5px}
  .badge{font:500 12.5px 'IBM Plex Mono',monospace;color:var(--teal-dark);background:#EAF4F5;border:1px solid #CFE4E5;border-radius:999px;padding:6px 12px;white-space:nowrap}
  .panel-note{margin:16px 0 0;font-size:12.5px;color:var(--muted)}
  .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:8px}
  .card{padding:22px;border-radius:14px}.card h3{margin:16px 0 8px;font-size:16px}.card p{margin:0;font-size:13.5px;color:#4A6B6E}
  .num{color:var(--teal);font:600 12px 'IBM Plex Mono',monospace}
  .schedule{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:center}
  .sheet{background:#fff;border:1px solid var(--line);border-radius:6px;box-shadow:0 30px 60px -30px rgba(11,47,51,.4);padding:26px 26px 22px;transform:rotate(-1deg)}
  .sheet-head{display:flex;align-items:center;gap:9px;padding-bottom:12px;border-bottom:2px solid var(--ink);font:700 15px 'Space Grotesk',sans-serif}
  .sheet-label{margin:14px 0 6px;font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.14em;color:var(--teal-dark)}.sheet-label.warn{color:#A2570F}
  .sheet-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;font-size:13.5px;color:#33555A}
  .sheet-list li:before{content:"[ ] ";color:#9DBFC1}
  .sheet-foot{margin:16px 0 0;font:400 10.5px 'IBM Plex Mono',monospace;color:#8FA9AB}
  .check-list{list-style:none;margin:0 0 22px;padding:0;display:flex;flex-direction:column;gap:10px}
  .check-list li{position:relative;padding-left:26px;font-size:15px;color:#33555A}
  .check-list li:before{content:"check";position:absolute;left:0;color:var(--teal);font-weight:700;font-size:10px;text-transform:uppercase}
  .check-list.on-dark li{color:#EBF7F8}.check-list.on-dark li:before{color:#8FD0D4}
  .offer{background:linear-gradient(150deg,#0A464D,#0E6E74 85%);border-radius:24px;color:#fff;display:grid;grid-template-columns:1.3fr .7fr;gap:60px;align-items:center}
  .offer h2{color:#fff}.offer p{color:rgba(235,247,248,.85)}
  .price{text-align:center;padding:30px;border-radius:16px}.price>strong{display:block;font-size:60px;color:var(--ink)}.price-sub{font-size:12.5px;color:var(--muted)}
  .calc-wrap{background:linear-gradient(165deg,#E9F5F6,#F7FAFB 70%);border-radius:24px;padding:clamp(48px,8vw,90px) 24px;text-align:center}
  .calc-wrap .head{margin:0 auto 30px;text-align:center}
  .tool-notice{max-width:900px;margin:22px auto 0;padding:16px 20px;border:1.5px solid #D9EAEB;border-radius:14px;background:#F2FAFA;text-align:left;font-size:14px;color:#33555A}
  .byline{display:grid;grid-template-columns:120px 1fr;gap:30px;align-items:center;background:#fff;border-radius:20px;padding:32px}
  .avatar{width:104px;height:104px;border-radius:50%;background:repeating-linear-gradient(45deg,#E7F2F3 0 10px,#F5FAFA 10px 20px);display:grid;place-items:center;font:500 9px 'IBM Plex Mono',monospace;color:#8FA9AB;text-align:center}
  .faq{background:#fff}.faq-list{max-width:850px;margin:0 auto}
  .faq details{border-top:1px solid var(--line)}
  .faq summary{padding:20px 4px;display:flex;justify-content:space-between;cursor:pointer;list-style:none;font:600 17px 'Space Grotesk',sans-serif}
  .faq summary::-webkit-details-marker{display:none}
  .faq details p{margin:0 0 22px;padding:0 4px;color:var(--sub)}.faq summary span{font-size:22px;color:var(--teal)}.faq details[open] summary span{transform:rotate(45deg);display:inline-block}
  .final{text-align:center;background:linear-gradient(165deg,#E9F5F6,#F7FAFB);border-radius:24px}.final h2{color:var(--ink);font-size:clamp(32px,5vw,50px)}
  .actions{display:flex;justify-content:center;align-items:center;gap:20px;flex-wrap:wrap;margin-top:18px}.text-link{border-bottom:2px solid var(--amber);font-weight:600;color:var(--ink)}
  footer{padding:44px max(24px,calc((100% - 1140px)/2));display:grid;grid-template-columns:1fr 1fr;gap:22px;background:var(--ink);color:rgba(231,244,245,.78)}
  footer nav{display:flex;gap:20px;justify-content:flex-end;flex-wrap:wrap;font-size:14px;font-weight:600}footer nav a{color:rgba(231,244,245,.78)}
  footer p{grid-column:1/-1;max-width:760px;font-size:13px;color:#a9c5cc}

  /* ---- WellWater HQ skin for the shared Tool engine ---- */
  .calc{background:var(--glass);border:1px solid rgba(255,255,255,.85);border-radius:22px;box-shadow:0 30px 70px -34px rgba(11,47,51,.35);text-align:left}
  .calc-inputs,.calc-results{padding:32px}
  .calc-field input,.calc-field select{border:1.5px solid #CFE2E3;border-radius:10px}
  .calc-results{background:#EFF8F4}
  .calc-results.tone-warn{background:#FFF3D6}.calc-results.tone-bad{background:#FBE6E1}
  .calc-dot{background:#1D7A4F}.tone-warn .calc-dot{background:#B9770E}.tone-bad .calc-dot{background:#B23B2E}

  @media(max-width:900px){.cards{grid-template-columns:repeat(2,1fr)}.schedule,.offer{grid-template-columns:1fr}.byline{grid-template-columns:80px 1fr}}
  @media(max-width:820px){.nav nav{display:none}}
  @media(max-width:580px){.hero{padding:48px 16px 60px}form.email{flex-direction:column}.cards{grid-template-columns:1fr}.section{padding-top:56px;padding-bottom:56px}.calc-inputs,.calc-results{padding:20px}.byline{grid-template-columns:1fr;text-align:center}.avatar{margin:0 auto}footer{grid-template-columns:1fr}footer nav{justify-content:flex-start}}
  @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
  </style>
</body>
</html>
