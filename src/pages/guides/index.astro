---
import { getCollection } from 'astro:content';
import site from '../../../site.config.json';
import Base from '../../layouts/Base.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="Free Well Water Study Guides and Articles | WellWater HQ" description="Every free well water guide on WellWater HQ, including the annual testing checklist for the 23 million U.S. households on private wells.">
<header class="nav">
    <a class="brand" href="/"><span class="drop"></span>WellWater <b>HQ</b></a>
    <nav aria-label="Main navigation">
      <a href="/#contaminants">Contaminants</a><a href="/#tool">Test Selector</a><a href="/guides/">Articles</a><a href="/#schedule">Free Schedule</a><a href="/#handbook">Handbook</a>
    </nav>
    <a class="btn sm" href="/#tool">Find Your Test</a>
  </header>
  <main class="guides">
    <h1>Articles</h1>
    <ul>
      {articles.map((a) => (
        <li>
          <h2><a href={`/${a.id}/`}>{a.data.title}</a></h2>
          <p>{a.data.description}</p>
          <small>{fmt(a.data.updatedDate ?? a.data.publishDate)}</small>
        </li>
      ))}
    </ul>
    {articles.length === 0 && <p>Articles are coming soon.</p>}
  </main>
<a href="https://2fe0bhufs5rxrhfhtc0bux4ka3.hop.clickbank.net/?tid=wellwater_banner" rel="sponsored nofollow noopener" target="_blank" class="ad ad-filled" style="display:flex;align-items:center;justify-content:space-between;gap:16px;width:min(970px,calc(100% - 32px));margin:27px auto;padding:14px 22px;border-radius:8px;background:linear-gradient(135deg,var(--navy,#12233b) 0%,var(--ink2,#1f2937) 100%);color:#fff;text-decoration:none;box-shadow:0 2px 10px rgba(0,0,0,.12);flex-wrap:wrap"><span style="display:flex;flex-direction:column;gap:2px;min-width:0"><span style="font:700 9px ui-monospace,monospace;letter-spacing:1.6px;text-transform:uppercase;opacity:.65">Sponsored</span><span style="font:700 15px 'Inter',sans-serif">The Lost SuperFoods</span><span style="font:400 12.5px 'Inter',sans-serif;opacity:.85">126 long-storing food methods and recipes for a reliable home stockpile.</span></span><span style="flex:0 0 auto;padding:10px 18px;border-radius:5px;background:var(--gold,#c9a24b);color:#12233b;font:700 13px 'Inter',sans-serif;white-space:nowrap">See the guide →</span></a>
<footer>
    <a class="brand" href="/"><span class="drop"></span>WellWater <b>HQ</b></a>
    <nav><a href="/guides/">Articles</a><a href="/#tool">Test Selector</a><a href="/#schedule">Free Schedule</a><a href="/#handbook">Handbook</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclosure/">Disclosure</a><a href="/editorial/">Editorial</a></nav>
    <p>WellWater HQ is reader-supported and may earn commissions from qualifying purchases through links on this site - it never changes what we recommend. See our <a href="/disclosure/">affiliate disclosure</a>.</p>
    <small>© 2026 {site.BRAND}</small>
  </footer>
</Base>

<style>
  .guides { max-width: 760px; margin: 0 auto; padding: 40px 20px 80px; }
  ul { list-style: none; padding: 0; }
  li { margin: 24px 0; }
  li a { font-weight: 700; font-size: 20px; }
  li h2 { margin: 0; }
  li p { margin: 4px 0; }
  small { opacity: .7; }
</style>
