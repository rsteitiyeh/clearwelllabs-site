---
/**
 * WellWater HQ landing -- flattened from the approved design
 * (production sites/05-well-water design: "WellWater HQ.dc.html").
 * Test-selector section mounts the shared Tool engine (Calculator.astro)
 * with a WellWater HQ teal/parchment skin below.
 */
import site from '../../site.config.json';
import Base from '../layouts/Base.astro';
import Tool from './Tool.astro';
---
<Base
  title="Well Water Testing: What to Test, When & Why | WellWater HQ"
  description="Independent, source-cited guides to private well water testing - coliform bacteria, nitrate, arsenic, lead, and PFAS. Free test selector, printable testing schedule, and honest lab-cost ranges."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'How often should I test my well water?', acceptedAnswer: { '@type': 'Answer', text: 'The EPA and CDC recommend testing private wells at least once a year for total coliform bacteria and nitrates, plus pH and total dissolved solids. Test again after flooding, well repairs, or any change in taste, odor, or appearance, and run a broader metals panel every 3-5 years per many state health departments.' } },
        { '@type': 'Question', name: 'What does well water testing cost?', acceptedAnswer: { '@type': 'Answer', text: 'Typical lab ranges: a basic bacteria + nitrate test runs about $30-$60; broad panels covering metals, minerals, and VOCs run about $150-$400; PFAS analysis by EPA methods runs about $250-$600. Many state and county health departments offer free or subsidized basic tests.' } },
        { '@type': 'Question', name: 'Can I test for PFAS at home?', acceptedAnswer: { '@type': 'Answer', text: 'You can collect the sample at home, but PFAS must be analyzed by an accredited laboratory using EPA methods such as 537.1 or 533. Instant strip-style tests cannot detect parts-per-trillion levels. Mail-in kits are fine when the analyzing lab is accredited.' } },
        { '@type': 'Question', name: 'What is a safe nitrate level?', acceptedAnswer: { '@type': 'Answer', text: 'The EPA maximum contaminant level is 10 mg/L nitrate as nitrogen. Water above that should not be given to infants under six months, because nitrate interferes with oxygen transport in their blood (methemoglobinemia). Boiling does not remove nitrate - it concentrates it.' } },
        { '@type': 'Question', name: 'Should I use a certified lab?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, for any result you will act on. State-certified labs follow EPA methods and quality controls, and their results are accepted for treatment decisions and real-estate transactions. Find one through your state health or environmental department, or the EPA Safe Drinking Water Hotline.' } },
        { '@type': 'Question', name: 'What do I do if coliform is detected?', acceptedAnswer: { '@type': 'Answer', text: 'Confirm with a retest, inspect the well cap, casing, and seal, then shock-chlorinate and retest. If E. coli is present, stop drinking the water immediately and use bottled or boiled water until two consecutive clean tests. Persistent detections call for continuous disinfection such as UV and a professional inspection.' } }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: 'How to test private well water',
      step: [
        { '@type': 'HowToStep', name: 'Choose your tests', text: "Your well's age, location, and household determine the list - the EPA recommends coliform bacteria and nitrate every year as the baseline." },
        { '@type': 'HowToStep', name: 'Order a kit or book a certified lab', text: 'For results you will act on, use a state-certified laboratory; mail-in kits are fine when the analyzing lab is accredited.' },
        { '@type': 'HowToStep', name: 'Sample and ship the same day', text: 'Follow the sterile-bottle instructions exactly. Bacteria samples must reach the lab within about 24-30 hours.' },
        { '@type': 'HowToStep', name: 'Read results against EPA levels', text: 'Compare each line of the report to the EPA reference level, confirm anything elevated with a certified lab, and retest annually and after floods or repairs.' }
      ]
    })} />
  </Fragment>

  <header class="nav">
    <a class="brand" href="#top"><span class="drop"></span>WellWater <b>HQ</b></a>
    <nav aria-label="Main navigation">
      <a href="#contaminants">Contaminants</a><a href="#tool">Test Selector</a><a href="/guides/">Articles</a><a href="#schedule">Free Schedule</a><a href="#handbook">Handbook</a>
    </nav>
    <a class="btn sm" href="#tool">Find Your Test</a>
  </header>
  <div class="ad">Advertisement</div>

  <main id="top">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow pill"><span class="dot"></span>Private well testing, explained</p>
        <h1>Know exactly what's in your <span>well water.</span></h1>
        <p class="lede">Over 23 million U.S. households rely on private wells - and no utility tests them for you. Get our free annual testing checklist and know what to test, when.</p>
        <form class="email" data-subscribe method="post">
          <label class="sr" for="email1">Email address</label>
          <input id="email1" name="fields[email]" type="email" required placeholder="you@example.com" />
          <button>Send Me the Checklist</button>
        </form>
        <p class="micro">Free. No spam. Unsubscribe anytime.</p>
      </div>
      <aside class="hero-card glass">
        <p class="eyebrow">The annual rhythm</p>
        <ul class="rhythm">
          <li><span class="check">check</span><strong>Coliform bacteria</strong> - every year</li>
          <li><span class="check">check</span><strong>Nitrate</strong> - every year</li>
          <li><span class="check">check</span><strong>Arsenic, lead & metals</strong> - every 3-5 years</li>
          <li><span class="warn">!</span><strong>Bacteria retest</strong> - after floods or repairs</li>
        </ul>
        <p class="tag">Based on EPA & CDC guidance</p>
      </aside>
    </section>

    <section class="trust">
      <p class="trust-lede">Guidance based on EPA, CDC, and state health department recommendations</p>
      <div class="trust-badges">
        <span>U.S. EPA - Private Wells</span>
        <span>CDC - Healthy Water</span>
        <span>State health departments</span>
      </div>
      <p class="trust-note">Every recommendation on this site cites a primary source. WellWater HQ is independent and not affiliated with or endorsed by these agencies.</p>
    </section>

    <section id="contaminants" class="section problem">
      <div class="head">
        <p class="eyebrow">The problem</p>
        <h2>Private wells have no municipal oversight.</h2>
        <p>If your water comes from a city main, a utility tests it constantly and publishes the results. A private well has no such safety net. The federal Safe Drinking Water Act sets legal limits for public water systems - but it does not apply to private wells.</p>
        <p>Arsenic leaching from bedrock, nitrate from fertilizer and septic runoff, lead from older plumbing, PFAS from industrial sites - all are invisible, tasteless, and odorless at levels that matter. A lab test is the only way to know.</p>
        <p class="src">Sources: <a href="https://www.epa.gov/privatewells" target="_blank" rel="noopener">US EPA - Private Drinking Water Wells</a> - <a href="https://www.cdc.gov/private-wells/" target="_blank" rel="noopener">CDC - Private Wells</a></p>
      </div>

      <div class="glass panel">
        <h3>What labs measure against</h3>
        <p class="panel-sub">Five contaminants every well owner should know, and the federal reference levels a certified lab will compare your results to.</p>
        <div class="row"><div><strong>Total coliform & E. coli</strong><small>Septic seepage, surface water, well defects</small></div><span class="badge">EPA standard - absent</span></div>
        <div class="row"><div><strong>Nitrate (as N)</strong><small>Fertilizer & septic runoff</small></div><span class="badge">10 mg/L - EPA MCL</span></div>
        <div class="row"><div><strong>Arsenic</strong><small>Natural bedrock deposits</small></div><span class="badge">10 ug/L - EPA MCL</span></div>
        <div class="row"><div><strong>PFOA & PFOS (PFAS)</strong><small>Firefighting foam, industrial sites</small></div><span class="badge">4.0 ppt - EPA MCL (2024)</span></div>
        <div class="row"><div><strong>Lead</strong><small>Household plumbing & solder</small></div><span class="badge">EPA goal - 0</span></div>
        <p class="panel-note">EPA maximum contaminant levels are legally enforceable only for public water systems - private wells aren't covered. Sources: <a href="https://www.epa.gov/ground-water-and-drinking-water/national-primary-drinking-water-regulations" target="_blank" rel="noopener">EPA Drinking Water Regulations</a> - <a href="https://www.epa.gov/sdwa/and-polyfluoroalkyl-substances-pfas" target="_blank" rel="noopener">EPA PFAS rule (2024)</a></p>
      </div>

      <div class="cards">
        <article class="glass card"><span class="num">01</span><h3>Choose your tests</h3><p>Your well's age, location, and household set the list. The <a href="#tool">free selector below</a> does this in a few questions.</p></article>
        <article class="glass card"><span class="num">02</span><h3>Order a kit or book a lab</h3><p>For results you'll act on, use a state-certified lab. Mail-in kits are fine when the analyzing lab is accredited.</p></article>
        <article class="glass card"><span class="num">03</span><h3>Sample & ship same day</h3><p>Follow the sterile-bottle instructions exactly - bacteria samples must reach the lab within about 24-30 hours.</p></article>
        <article class="glass card"><span class="num">04</span><h3>Read results vs. EPA levels</h3><p>Compare each line to the reference level, confirm anything elevated, and retest annually or after floods and repairs.</p></article>
      </div>
    </section>
    <div class="ad">Advertisement</div>

    <section id="schedule" class="section schedule">
      <div class="sheet">
        <div class="sheet-head"><span class="drop small"></span><strong>The Well Owner's Testing Schedule</strong></div>
        <p class="sheet-label">Every year</p>
        <ul class="sheet-list"><li>Total coliform & E. coli</li><li>Nitrate / nitrite</li><li>pH & total dissolved solids</li></ul>
        <p class="sheet-label">Every 3-5 years</p>
        <ul class="sheet-list"><li>Arsenic, lead & manganese</li><li>Uranium & fluoride</li><li>Hardness & iron</li></ul>
        <p class="sheet-label warn">After floods, repairs, or changes</p>
        <ul class="sheet-list"><li>Bacteria retest before drinking</li><li>Anything that changed nearby</li></ul>
        <p class="sheet-foot">wellwaterhq - cites EPA & CDC guidance</p>
      </div>
      <div>
        <p class="eyebrow light">Free download</p>
        <h2>The Well Owner's Testing Schedule</h2>
        <p>One printable page: what to test every year, what to test every 3-5 years, and what to retest after floods or repairs. Stick it on the pressure tank and stop guessing.</p>
        <ul class="check-list">
          <li>Annual, 3-5 year, and after-event tests in one view</li>
          <li>Every line cites its EPA or CDC source</li>
          <li>Printer-friendly, with a log column for your results</li>
        </ul>
        <form class="email compact" data-subscribe method="post">
          <label class="sr" for="email2">Email address</label>
          <input id="email2" name="fields[email]" type="email" required placeholder="you@example.com" />
          <button>Email Me the Checklist</button>
        </form>
        <p class="micro">Free. No spam. Unsubscribe anytime.</p>
      </div>
    </section>

    <section id="handbook" class="section offer">
      <div>
        <p class="eyebrow light">Go deeper - free</p>
        <h2>The Complete Well Water Handbook</h2>
        <p>The checklist tells you what to test. The handbook walks you through everything after the results arrive.</p>
        <ul class="check-list on-dark">
          <li>Read a lab report line by line - units, MCLs, and what "detect" actually means</li>
          <li>Choose a state-certified lab and order the right panels the first time</li>
          <li>Match filtration to confirmed results - UV, RO, softeners, carbon, and what each treats</li>
          <li>Worksheets: a testing log and a treatment decision tree</li>
        </ul>
        <form class="email" data-subscribe method="post">
          <label class="sr" for="email3">Email address</label>
          <input id="email3" name="fields[email]" type="email" required placeholder="you@example.com" />
          <button type="submit">Send Me the Free Handbook</button>
        </form>
        <p class="micro on-dark">Free. No spam. Unsubscribe anytime.</p>
      </div>
      <div class="glass price">
        <p>Free digital handbook</p>
        <p class="price-sub">From lab report to fixed water - step by step</p>
      </div>
    </section>

    <section id="tool" class="calc-wrap">
      <div class="head">
        <p class="eyebrow light">Free - no ads - no email required</p>
        <h2>Which tests does your well actually need?</h2>
        <p>Answer a few questions. Get a prioritized testing plan built from EPA and state guidance - not a one-size-fits-all bundle.</p>
      </div>
      <Tool />
      <div class="tool-notice">
        <p><strong>Before you buy treatment:</strong> confirm any result above an EPA reference level with a state-certified lab. Treatment should match a confirmed result - not a fear.</p>
      </div>
    </section>

    <section id="about" class="section byline">
      <div>
        <p class="eyebrow">Written & reviewed by</p>
        <h2>{site.author.name}</h2>
        <p>Written and maintained by {site.author.name}.</p>
        <p>{site.author.bio}</p>
        <p class="panel-note">Every article on WellWater HQ cites primary sources - EPA, CDC, state health departments, and peer-reviewed research - and is reviewed on a set schedule.</p>
      </div>
    </section>
    <div class="ad">Advertisement</div>

    <section class="section faq">
      <div class="head"><p class="eyebrow">FAQ</p><h2>Well testing, answered honestly</h2></div>
      <div class="faq-list">
        <details open><summary>How often should I test my well water?<span>+</span></summary><p>The EPA and CDC recommend testing at least once a year for total coliform bacteria and nitrates, plus pH and total dissolved solids. Test again after flooding, well repairs, or any change in taste, odor, or appearance - and run a broader metals panel (arsenic, lead, manganese, uranium) every 3-5 years, per many state health departments.</p></details>
        <details><summary>What does well water testing cost?<span>+</span></summary><p>Typical lab ranges: a basic bacteria + nitrate test runs about $30-$60; broad panels covering metals, minerals, and VOCs run $150-$400; PFAS analysis by EPA methods runs $250-$600. Check your state or county health department first - many offer free or subsidized basic tests for well owners.</p></details>
        <details><summary>Can I test for PFAS at home?<span>+</span></summary><p>You can collect the sample at home, but the analysis has to happen at an accredited lab using EPA methods (537.1 or 533). PFAS matters at parts-per-trillion levels - the EPA's 2024 limit for PFOA and PFOS is 4.0 ppt - and no instant strip test can see that. Mail-in kits are legitimate when the analyzing lab is accredited.</p></details>
        <details><summary>What is a safe nitrate level?<span>+</span></summary><p>The EPA maximum contaminant level is 10 mg/L nitrate as nitrogen. Water above that should never be given to infants under six months - nitrate interferes with oxygen transport in their blood (methemoglobinemia, or "blue-baby syndrome"). Boiling concentrates nitrate, it doesn't remove it. Treatment means reverse osmosis or ion exchange.</p></details>
        <details><summary>Should I use a certified lab?<span>+</span></summary><p>Yes - for any result you'll act on. State-certified labs follow EPA methods and quality controls, and their results are accepted for treatment decisions and real-estate transactions. Find certified labs through your state health or environmental department, or the EPA Safe Drinking Water Hotline.</p></details>
        <details><summary>What do I do if coliform is detected?<span>+</span></summary><p>Confirm with a retest, inspect the well cap, casing, and seal, then shock-chlorinate and retest. If E. coli is present, stop drinking the water immediately - use bottled or boiled water until two consecutive clean tests. Persistent detections call for continuous disinfection (UV is common) and a professional inspection.</p></details>
      </div>
    </section>

    <section class="final">
      <p class="eyebrow light">Not sure where to start?</p>
      <h2>Start with the free test selector.</h2>
      <p>A couple minutes gives you a prioritized plan - not a sales pitch.</p>
      <div class="actions"><a class="btn" href="#tool">Open the Free Test Selector</a><a class="text-link" href="#handbook">Get the free handbook -></a></div>
    </section>
  </main>

  <footer>
    <a class="brand" href="#top"><span class="drop"></span>WellWater <b>HQ</b></a>
    <nav><a href="/guides/">Articles</a><a href="#tool">Test Selector</a><a href="#schedule">Free Schedule</a><a href="#handbook">Handbook</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclosure/">Disclosure</a><a href="/editorial/">Editorial</a></nav>
    <p>WellWater HQ is reader-supported and may earn commissions from qualifying purchases through links on this site - it never changes what we recommend. See our <a href="/disclosure/">affiliate disclosure</a>.</p>
    <small>© 2026 {site.BRAND}</small>
  </footer>
</Base>

<style is:global>
  :root{--teal:#0E6E74;--teal-dark:#0A565B;--ink:#0B2F33;--sub:#3E6165;--muted:#5B7B7E;--bg:#F7FAFB;--amber:#EE9D3D;--glass:rgba(255,255,255,.78);--line:#E2EEEF}
  *{box-sizing:border-box}html{scroll-behavior:smooth}
  body{margin:0;color:var(--ink);background:var(--bg);font:16.5px/1.65 'IBM Plex Sans',system-ui,sans-serif}
  a{color:var(--teal-dark);text-decoration:none}button,input,select{font:inherit}
  h1,h2,h3{font-family:'Space Grotesk',sans-serif;letter-spacing:-0.02em}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .nav{position:sticky;z-index:20;top:0;background:rgba(255,255,255,.85);backdrop-filter:blur(14px);border-bottom:1px solid rgba(14,110,116,.12);display:flex;align-items:center;gap:18px;padding:12px max(24px,calc((100% - 1160px)/2))}
  .brand{display:flex;align-items:center;gap:9px;font:700 19px 'Space Grotesk',sans-serif;color:var(--ink);margin-right:auto;white-space:nowrap}.brand b{color:var(--teal)}
  .drop{width:20px;height:20px;border-radius:40% 40% 50% 50%;background:linear-gradient(160deg,var(--teal),var(--teal-dark));display:inline-block}.drop.small{width:16px;height:16px}
  .nav nav{display:flex;gap:4px;font-size:14.5px;font-weight:500}
  .nav nav a{padding:8px 12px;border-radius:9px;color:#33555A}.nav nav a:hover{background:#EDF5F6;color:var(--teal-dark)}
  .btn,form.email button{display:inline-flex;justify-content:center;align-items:center;gap:8px;border:0;border-radius:12px;padding:13px 22px;background:var(--amber);color:var(--ink);font:600 15px 'Space Grotesk',sans-serif;cursor:pointer;box-shadow:0 12px 26px -12px rgba(206,124,24,.7);transition:.18s}
  .btn:hover,form.email button:hover{transform:translateY(-2px)}.btn.sm{padding:9px 16px;font-size:13.5px;box-shadow:none;background:var(--teal);color:#fff}
  .ad{min-height:90px;width:min(970px,calc(100% - 32px));margin:22px auto;display:grid;place-items:center;border:1.5px dashed #C4DBDC;border-radius:10px;background:#FAFDFD;color:#8FA9AB;font:11px 'IBM Plex Mono',monospace;letter-spacing:1.8px;text-transform:uppercase}
  .hero{max-width:1140px;margin:0 auto;padding:clamp(48px,8vw,90px) 24px;display:flex;flex-wrap:wrap;gap:50px 60px;align-items:center;background:radial-gradient(1100px 520px at 78% -12%,#CFE9EA 0,transparent 62%)}
  .hero-copy{flex:1 1 500px;min-width:0}
  .eyebrow{margin:0 0 12px;font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:var(--teal-dark)}.eyebrow.light{color:#9FD4D7}
  .pill{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.7);border:1px solid #CFE4E5;border-radius:999px;padding:8px 14px}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--teal)}
  .hero h1{margin:0 0 20px;font-size:clamp(34px,5.4vw,58px);line-height:1.06;color:var(--ink)}.hero h1 span{color:var(--teal)}
  .lede{margin:0 0 28px;max-width:580px;font-size:clamp(16px,1.6vw,19px);color:var(--sub)}
  form.email{display:flex;gap:10px;max-width:520px}form.email input{flex:1;min-width:0;padding:14px 16px;border:1.5px solid #C6DDDE;border-radius:12px;background:#fff}
  form.email input:focus,input:focus,select:focus{outline:3px solid #BFE3E5}
  .micro{font-size:12.5px;color:var(--muted);margin-top:12px}.micro.on-dark{color:rgba(235,247,248,.65)}
  .hero-card{flex:0 1 320px;min-width:270px;padding:26px 28px;border-radius:20px}
  .glass{background:var(--glass);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.85);box-shadow:0 30px 70px -32px rgba(11,47,51,.4)}
  .rhythm{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:13px}
  .rhythm li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;color:var(--ink)}
  .rhythm .check{color:var(--teal);font-weight:700}.rhythm .warn{color:#B9770E;font-weight:700}
  .tag{margin:18px 0 0;display:inline-block;font:500 11px 'IBM Plex Mono',monospace;color:var(--teal-dark);background:#EAF4F5;border:1px solid #CFE4E5;border-radius:999px;padding:6px 12px}
  .trust{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:26px max(24px,calc((100% - 1140px)/2));display:flex;flex-wrap:wrap;gap:14px 26px;align-items:center;max-width:1140px;margin:0 auto}
  .trust-lede{margin:0;font:600 14px 'Space Grotesk',sans-serif}
  .trust-badges{display:flex;flex-wrap:wrap;gap:9px;margin-left:auto}
  .trust-badges span{padding:7px 13px;border:1px solid #D4E6E7;border-radius:999px;font:500 12px 'IBM Plex Mono',monospace;color:#33555A;background:#FBFDFD}
  .trust-note{margin:0;flex:1 1 100%;font-size:12.5px;color:var(--muted)}
  .section{max-width:1140px;margin:0 auto;padding:clamp(56px,8vw,100px) 24px}
  .head{max-width:700px;margin-bottom:36px}
  .head h2,.schedule h2,.offer h2,.final h2{margin:0 0 15px;font-size:clamp(30px,4vw,44px);line-height:1.1;color:var(--ink)}
  .head p{font-size:17px;color:var(--sub)}
  .problem .head p{margin:0 0 14px}.src{font:400 12.5px 'IBM Plex Mono',monospace;color:var(--muted)}
  .panel{border-radius:20px;padding:clamp(22px,3.5vw,32px);margin:32px 0}
  .panel h3{margin:0 0 6px;font-size:20px}.panel-sub{margin:0 0 8px;font-size:14px;color:#4A6B6E}
  .row{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;padding:15px 0;border-top:1px solid #D9EAEB}
  .row div{flex:1 1 220px}.row strong{display:block;font:600 15.5px 'Space Grotesk',sans-serif}.row small{color:#5B7B7E;font-size:12.5px}
  .badge{font:500 12.5px 'IBM Plex Mono',monospace;color:var(--teal-dark);background:#EAF4F5;border:1px solid #CFE4E5;border-radius:999px;padding:6px 12px;white-space:nowrap}
  .panel-note{margin:16px 0 0;font-size:12.5px;color:var(--muted)}
  .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:8px}
  .card{padding:22px;border-radius:14px}.card h3{margin:16px 0 8px;font-size:16px}.card p{margin:0;font-size:13.5px;color:#4A6B6E}
  .num{color:var(--teal);font:600 12px 'IBM Plex Mono',monospace}
  .schedule{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:center}
  .sheet{background:#fff;border:1px solid var(--line);border-radius:6px;box-shadow:0 30px 60px -30px rgba(11,47,51,.4);padding:26px 26px 22px;transform:rotate(-1deg)}
  .sheet-head{display:flex;align-items:center;gap:9px;padding-bottom:12px;border-bottom:2px solid var(--ink);font:700 15px 'Space Grotesk',sans-serif}
  .sheet-label{margin:14px 0 6px;font:600 10.5px 'IBM Plex Mono',monospace;letter-spacing:.14em;color:var(--teal-dark)}.sheet-label.warn{color:#A2570F}
  .sheet-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;font-size:13.5px;color:#33555A}
